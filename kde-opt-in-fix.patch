+# Apply a package-specific choice after inherited profile USE defaults.
+# Do not disable KDE globally: another explicitly chosen desktop may need it.
+configure_asahi_desktop() {
+  local portage_dir=${1:-/etc/portage} flag=-kde
+  if opt ASAHI_KDE; then flag=kde; fi
+  mkdir -p "$portage_dir/package.use"
+  printf 'sys-apps/asahi-meta %s\n' "$flag" >"$portage_dir/package.use/zz-asahi-installer-desktop"
+  info "Asahi KDE/KWin integration: $flag (change in Install options)"
+}
+
 # Prepare both installation paths before invoking the upstream helper.
 s2_prepare_asahi() {
   mkdir -p /etc/portage/repos.conf /etc/portage/package.use /etc/portage/package.accept_keywords
@@ -757,6 +768,7 @@
