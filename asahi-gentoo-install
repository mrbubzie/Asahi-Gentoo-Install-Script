#!/usr/bin/env bash
# asahi-gentoo-install - a menu-driven Gentoo installer for Apple Silicon (Asahi)
#
# Modeled after oddlama/gentoo-install (TUI configurator + config file +
# checked install steps), but built around the Asahi boot chain:
#   m1n1 -> U-Boot -> GRUB (EFI) -> kernel/initramfs
#
# PREREQUISITES (done by you beforehand, NOT by this script):
#   1. Run the Asahi installer from macOS:  curl https://alx.sh | sh
#      Choose "UEFI environment only" and reserve free space for Gentoo.
#   2. Boot the Gentoo Asahi live ISO (chadmed.au/pub/gentoo).
#   3. Create a root partition in the free space (menu item or cfdisk).
#
# This script NEVER modifies the partition table and NEVER formats the ESP.
# It refuses to touch partitions with Apple GPT type GUIDs (APFS, recovery...).
#
# Usage:
#   ./asahi-gentoo-install                 interactive menu
#   ./asahi-gentoo-install -c FILE         load FILE, open menu
#   ./asahi-gentoo-install -c FILE -y      load FILE, skip destructive confirmation (other prompts remain)
#   ./asahi-gentoo-install --chroot /mnt/gentoo   mount helper + chroot into existing system
#
set -Eeuo pipefail

VERSION="0.1.1"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
TARGET="/mnt/gentoo"
CONF_FILE="./asahi-gentoo.conf"
CHROOT_CONF="/root/asahi-gentoo.conf"
ASSUME_YES=0
RET=""

# ---------------------------------------------------------------- config ----
CONFIG_VARS=(
  ESP_PART ROOT_PART SWAP_PART ESP_MOUNT ROOT_FS USE_LUKS
  STAGE_VARIANT GENTOO_MIRROR PROFILE
  HOSTNAME_ TIMEZONE LOCALE KEYMAP
  ROOT_PW_HASH USER_NAME USER_PW_HASH USER_GROUPS
  OPTIONS NETWORK EXTRA_PACKAGES EXTRA_USE
  ASAHI_SETUP ASAHI_OVERLAY_URI ASAHI_SUPPORT_URI
)

set_defaults() {
  ESP_PART=""; ROOT_PART=""; SWAP_PART=""
  ESP_MOUNT="/boot"           # Required by the Gentoo Asahi firmware and boot integration
  ROOT_FS="ext4"              # ext4 | btrfs | xfs
  USE_LUKS="no"
  STAGE_VARIANT="desktop-openrc"
  GENTOO_MIRROR="https://distfiles.gentoo.org"
  PROFILE="ask-later"         # preset path | ask-later (pick from eselect list in chroot)
  HOSTNAME_="gentoo-mac"
  TIMEZONE="UTC"
  LOCALE="en_US.UTF-8"
  KEYMAP="us"
  ROOT_PW_HASH=""; USER_NAME=""; USER_PW_HASH=""
  USER_GROUPS="wheel,audio,video,input,users"
  OPTIONS="VERIFY SUDO"       # flags, see OPTION_ITEMS
  NETWORK="iwd"               # iwd | networkmanager | none
  EXTRA_PACKAGES=""; EXTRA_USE=""
  ASAHI_SETUP="gentoosupport" # gentoosupport (official, recommended) | native (experimental)
  ASAHI_OVERLAY_URI="https://github.com/chadmed/asahi-overlay.git"
  ASAHI_SUPPORT_URI="https://github.com/chadmed/asahi-gentoosupport.git"
}

# tag | description | default-on
OPTION_ITEMS=(
  "LICENSES"  "Accept ALL licenses (ACCEPT_LICENSE=\"*\")"
  "VERIFY"    "Verify stage3 GPG signature (recommended)"
  "BINPKG"    "Use Gentoo binary package host (faster, fewer compiles)"
  "TESTING"   "Accept testing keywords (~arm64)"
  "GITSYNC"   "Sync the Gentoo tree via git instead of rsync"
  "WORLD"     "Run full @world update after setup (slow)"
  "NATIVE"    "Optimize for this CPU (-mcpu=native)"
  "SUDO"      "Install sudo and allow the wheel group"
  "SSHD"      "Install and enable sshd"
  "CHRONY"    "Install and enable chrony (time sync)"
)

opt() { [[ " $OPTIONS " == *" $1 "* ]]; }

save_config() {
  local f=$1 v
  ( umask 077
  { echo "# asahi-gentoo-install config (v$VERSION)"
    for v in "${CONFIG_VARS[@]}"; do printf '%s=%q\n' "$v" "${!v}"; done
  } >"$f"
  chmod 600 "$f"
  )
}

load_config() { # shellcheck disable=SC1090
  source "$1"; }

# ---------------------------------------------------------------- output ----
c_red=$'\e[1;31m'; c_grn=$'\e[1;32m'; c_ylw=$'\e[1;33m'; c_off=$'\e[0m'
info() { echo "${c_grn}[*]${c_off} $*" >&2; }
warn() { echo "${c_ylw}[!]${c_off} $*" >&2; }
die()  { echo "${c_red}[x]${c_off} $*" >&2; exit 1; }

# ------------------------------------------------------------------- UI -----
# All UI helpers return their value in $RET and exit status 1 on cancel.
if   command -v dialog   >/dev/null 2>&1; then UI=dialog
elif command -v whiptail >/dev/null 2>&1; then UI=whiptail
else UI=plain; fi

ui_menu() { # title prompt tag desc [tag desc ...]
  local title=$1 prompt=$2; shift 2
  if [[ $UI != plain ]]; then
    RET=$($UI --title "$title" --menu "$prompt" 24 78 15 "$@" 3>&1 1>&2 2>&3) || return 1
  else
    local tags=() i=0 n
    { echo; echo "== $title =="; echo "$prompt"; } >&2
    while (($#)); do tags+=("$1"); printf '  %2d) %-16s %s\n' $((++i)) "$1" "$2" >&2; shift 2; done
    read -r -p "> " n </dev/tty || return 1
    [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#tags[@]})) || return 1
    RET=${tags[n-1]}
  fi
}

ui_input() { # title prompt default
  if [[ $UI != plain ]]; then
    RET=$($UI --title "$1" --inputbox "$2" 11 74 "$3" 3>&1 1>&2 2>&3) || return 1
  else
    read -r -p "$1 - $2 [$3]: " RET </dev/tty || return 1
    [[ -n $RET ]] || RET=$3
  fi
}

ui_pass() { # title prompt
  if [[ $UI == dialog ]]; then
    RET=$(dialog --title "$1" --insecure --passwordbox "$2" 10 60 3>&1 1>&2 2>&3) || return 1
  elif [[ $UI == whiptail ]]; then
    RET=$(whiptail --title "$1" --passwordbox "$2" 10 60 3>&1 1>&2 2>&3) || return 1
  else
    read -r -s -p "$2: " RET </dev/tty || return 1; echo >&2
  fi
}

ui_yesno() { # title prompt
  if [[ $UI != plain ]]; then
    $UI --title "$1" --yesno "$2" 14 74
  else
    local a; read -r -p "$1 - $2 [y/N]: " a </dev/tty; [[ $a == [yY]* ]]
  fi
}

ui_msg() { # title text
  if [[ $UI != plain ]]; then $UI --title "$1" --msgbox "$2" 16 74
  else { echo; echo "== $1 =="; echo "$2"; } >&2; read -r -p "[enter]" _ </dev/tty || true; fi
}

ui_checklist() { # title prompt tag desc state(on/off) ...
  local title=$1 prompt=$2; shift 2
  if [[ $UI != plain ]]; then
    RET=$($UI --title "$title" --checklist "$prompt" 22 78 12 "$@" 3>&1 1>&2 2>&3) || return 1
    RET=${RET//\"/}
  else
    local tags=() descs=() state=() i n
    while (($#)); do tags+=("$1"); descs+=("$2"); [[ $3 == on ]] && state+=(1) || state+=(0); shift 3; done
    while true; do
      { echo; echo "== $title =="; echo "$prompt"; } >&2
      for i in "${!tags[@]}"; do
        printf '  %2d) [%s] %-10s %s\n' $((i+1)) "$([[ ${state[i]} == 1 ]] && echo x || echo ' ')" "${tags[i]}" "${descs[i]}" >&2
      done
      read -r -p "toggle number (empty = done): " n </dev/tty || return 1
      [[ -z $n ]] && break
      [[ $n =~ ^[0-9]+$ ]] && ((n >= 1 && n <= ${#tags[@]})) && state[n-1]=$((1 - state[n-1]))
    done
    RET=""; for i in "${!tags[@]}"; do [[ ${state[i]} == 1 ]] && RET+="${tags[i]} "; done
    RET=${RET% }
  fi
}

# ------------------------------------------------------- checked commands ---
try() { # Essential commands must succeed; retry, shell, or abort.
  local a
  while true; do
    "$@" && return 0
    warn "Command failed: $*"
    read -r -p "[r]etry, [s]hell, [a]bort? " a </dev/tty || a=a
    case $a in
      r|R) ;;
      s|S) bash </dev/tty || true ;;
      *)   die "Aborted." ;;
    esac
  done
}

hash_pw() { # password -> sha512 crypt hash in $RET
  local pw=$1
  if command -v openssl >/dev/null 2>&1; then RET=$(openssl passwd -6 -stdin <<<"$pw")
  elif command -v mkpasswd >/dev/null 2>&1; then RET=$(mkpasswd -m sha-512 -s <<<"$pw")
  else die "Password hashing requires openssl or mkpasswd."; fi
}

ask_password() { # title -> hash in $RET
  local p1 p2
  while true; do
    ui_pass "$1" "Enter password" || return 1; p1=$RET
    ui_pass "$1" "Repeat password" || return 1; p2=$RET
    [[ -n $p1 && $p1 == "$p2" ]] && break
    ui_msg "Password" "Passwords are empty or do not match. Try again."
  done
  hash_pw "$p1"
}

# --------------------------------------------------- partition selection ----
APPLE_SUFFIX="-11aa-aa11-00306543ecac"       # all Apple GPT type GUIDs end in this
ESP_GUID="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"

pick_partition() { # role(esp|root|swap) prompt
  local role=$1 prompt=$2 line items=()
  while IFS= read -r line; do
    local NAME="" TYPE="" SIZE="" FSTYPE="" PARTTYPE="" PARTLABEL="" MOUNTPOINTS=""
    eval "$line"
    [[ $TYPE == part ]] || continue
    [[ -z $MOUNTPOINTS ]] || continue                      # in use (e.g. live media)
    [[ ${PARTTYPE,,} == *"$APPLE_SUFFIX" ]] && continue    # Apple-owned: never offer
    local is_esp=0; [[ ${PARTTYPE,,} == "$ESP_GUID" ]] && is_esp=1
    case $role in
      esp)       ((is_esp)) || continue ;;
      root|swap) ((is_esp)) && continue ;;
    esac
    [[ $role == swap && $NAME == "$ROOT_PART" ]] && continue
    [[ $role == root && $NAME == "$SWAP_PART" ]] && continue
    items+=("$NAME" "$SIZE  ${FSTYPE:-no-fs}  ${PARTLABEL}")
  done < <(lsblk -pPno NAME,TYPE,SIZE,FSTYPE,PARTTYPE,PARTLABEL,MOUNTPOINTS)
  if ((${#items[@]} == 0)); then
    ui_msg "Partitions" "No suitable $role partition found. Create one in the free space Asahi reserved for you (main menu: 'Create partition')."
    return 1
  fi
  ui_menu "Select $role partition" "$prompt" "${items[@]}"
}

create_partition() {
  local items=() line
  while IFS= read -r line; do
    local NAME="" TYPE="" SIZE="" MODEL=""; eval "$line"
    [[ $TYPE == disk ]] && items+=("$NAME" "$SIZE $MODEL")
  done < <(lsblk -pPno NAME,TYPE,SIZE,MODEL)
  ui_msg "cfdisk" "DANGER: only add a partition in the FREE SPACE reserved by the Asahi installer.\nDo NOT delete, resize or retype any existing partition - that can require a DFU restore of your Mac."
  ui_menu "Disk" "Open cfdisk on which disk?" "${items[@]}" || return 0
  cfdisk "$RET" </dev/tty || true
  partprobe "$RET" 2>/dev/null || true
}

# ------------------------------------------------------ configure menus ----
cfg_partitions() {
  pick_partition esp "EFI System Partition created by the Asahi installer.\nIt is mounted, NOT formatted." || return 0
  ESP_PART=$RET
  pick_partition root "ROOT partition. It WILL BE FORMATTED." || return 0
  ROOT_PART=$RET
  if ui_yesno "Swap" "Use a swap partition?"; then
    pick_partition swap "Swap partition. It WILL BE FORMATTED." && SWAP_PART=$RET || SWAP_PART=""
  else SWAP_PART=""; fi
  ESP_MOUNT=/boot
  info "The Asahi ESP will be mounted at /boot."
}

cfg_filesystem() {
  ui_menu "Root filesystem" "Filesystem for the root partition" \
    ext4 "ext4 (default, safest)" btrfs "btrfs (zstd compression, 16K sectors)" xfs "xfs" || return 0
  ROOT_FS=$RET
  if ui_yesno "LUKS" "Encrypt the root partition with LUKS2?\n(You will be asked for the passphrase during install and at every boot.)"; then
    USE_LUKS=yes; else USE_LUKS=no; fi
}

cfg_stage() {
  ui_menu "Stage3 variant" "arm64 stage3 tarball to install" \
    openrc          "Minimal, OpenRC" \
    systemd         "Minimal, systemd" \
    desktop-openrc  "Desktop, OpenRC" \
    desktop-systemd "Desktop, systemd" \
    llvm-openrc     "LLVM/clang toolchain, OpenRC" \
    llvm-systemd    "LLVM/clang toolchain, systemd" || return 0
  STAGE_VARIANT=$RET
  # a profile must match the init system, reset it
  PROFILE="ask-later"
  ui_input "Mirror" "Gentoo mirror base URL" "$GENTOO_MIRROR" && GENTOO_MIRROR=${RET%/} || true
}

cfg_profile() {
  local sd=""; [[ $STAGE_VARIANT == *systemd ]] && sd="/systemd"
  local b="default/linux/arm64/23.0"
  ui_menu "Profile" "Portage profile (init system must match the stage3: ${STAGE_VARIANT##*-})" \
    ask-later              "Pick from 'eselect profile list' inside the chroot" \
    "$b$sd"                "Base" \
    "$b/desktop$sd"        "Desktop" \
    "$b/desktop/gnome$sd"  "Desktop + GNOME" \
    "$b/desktop/plasma$sd" "Desktop + KDE Plasma" \
    custom                 "Type a profile path manually" || return 0
  if [[ $RET == custom ]]; then ui_input "Profile" "Profile path, e.g. default/linux/arm64/23.0/desktop" "$PROFILE" || return 0; fi
  PROFILE=$RET
}

cfg_system() {
  ui_input "Hostname" "Hostname" "$HOSTNAME_" && HOSTNAME_=$RET || return 0
  ui_input "Timezone" "Timezone (e.g. Europe/Berlin, America/New_York)" "$TIMEZONE" && TIMEZONE=$RET || return 0
  ui_input "Locale" "Locale (UTF-8)" "$LOCALE" && LOCALE=$RET || return 0
  ui_input "Keymap" "Console keymap (us, de, uk, ...)" "$KEYMAP" && KEYMAP=$RET || return 0
}

cfg_users() {
  ask_password "Root password" && ROOT_PW_HASH=$RET || return 0
  if ui_yesno "User" "Create a regular user?"; then
    ui_input "User" "Username" "${USER_NAME:-user}" && USER_NAME=$RET || return 0
    ask_password "Password for $USER_NAME" && USER_PW_HASH=$RET || return 0
    ui_input "Groups" "Supplementary groups" "$USER_GROUPS" && USER_GROUPS=$RET || true
  else USER_NAME=""; USER_PW_HASH=""; fi
}

cfg_options() {
  local args=() i
  for ((i = 0; i < ${#OPTION_ITEMS[@]}; i += 2)); do
    args+=("${OPTION_ITEMS[i]}" "${OPTION_ITEMS[i+1]}" "$(opt "${OPTION_ITEMS[i]}" && echo on || echo off)")
  done
  ui_checklist "Install options" "Space toggles, Enter confirms" "${args[@]}" && OPTIONS=$RET || true
}

cfg_packages() {
  ui_menu "Networking" "Wi-Fi/network stack for the installed system" \
    iwd "iwd with built-in DHCP (lightweight)" \
    networkmanager "NetworkManager (iwd backend)" \
    none "Configure yourself" && NETWORK=$RET || true
  ui_input "Packages" "Extra packages to emerge (space separated, may be empty)" "$EXTRA_PACKAGES" && EXTRA_PACKAGES=$RET || true
  ui_input "USE" "Extra global USE flags (space separated, may be empty)" "$EXTRA_USE" && EXTRA_USE=$RET || true
}

cfg_asahi() {
  ui_menu "Asahi setup method" "How should kernel, GRUB, m1n1/U-Boot and firmware be installed?" \
    gentoosupport "Official chadmed/asahi-gentoosupport install.sh (interactive, recommended)" \
    native        "Overlay + asahi-meta + GRUB driven by this script (experimental)" || return 0
  ASAHI_SETUP=$RET
  ui_input "Overlay" "Asahi overlay git URI" "$ASAHI_OVERLAY_URI" && ASAHI_OVERLAY_URI=$RET || true
  ui_input "Support repo" "asahi-gentoosupport git URI" "$ASAHI_SUPPORT_URI" && ASAHI_SUPPORT_URI=$RET || true
}

validate_config() {
  local err="" p t id seen=" "
  [[ -b $ESP_PART  ]] || err+="ESP partition not set or missing.\n"
  [[ -b $ROOT_PART ]] || err+="Root partition not set or missing.\n"
  [[ -z $SWAP_PART || -b $SWAP_PART ]] || err+="Swap partition missing.\n"
  [[ -n $ROOT_PW_HASH ]] || err+="Root password not set.\n"
  [[ $ESP_PART != "$ROOT_PART" ]] || err+="ESP and root are the same partition.\n"
  for p in "$ESP_PART" "$ROOT_PART" "$SWAP_PART"; do
    [[ -z $p || ! -b $p ]] && continue
    t=$(lsblk -dnro PARTTYPE "$p" | tr 'A-Z' 'a-z')
    [[ $(lsblk -dnro TYPE "$p") == part ]] || err+="$p is not a partition.\n"
    id=$(lsblk -dnro MAJ:MIN "$p")
    if [[ -z $id || $seen == *" $id "* ]]; then err+="Devices overlap or cannot be identified: $p.\n"; fi
    seen+="$id "
    if lsblk -nrpo MOUNTPOINTS "$p" | grep -q '[^[:space:]]'; then err+="$p or a child device is mounted.\n"; fi
    while read -r t; do
      [[ -z $t ]] || err+="$p has an active child device ($t).\n"
    done < <(lsblk -nrpo NAME "$p" | tail -n +2)
    while read -r t; do
      [[ -z $t ]] && continue
      [[ $(lsblk -dnro MAJ:MIN "$t" 2>/dev/null || true) != "$id" ]] || err+="$p is active swap.\n"
    done < <(swapon --show=NAME --noheadings --raw)
    t=$(lsblk -dnro PARTTYPE "$p" | tr 'A-Z' 'a-z')
    [[ $t == *"$APPLE_SUFFIX" ]] && err+="$p has an Apple partition type; refusing.\n"
  done
  [[ $(lsblk -dnro PARTTYPE "$ESP_PART" 2>/dev/null | tr 'A-Z' 'a-z') == "$ESP_GUID" ]] || err+="Selected ESP does not have the EFI partition type.\n"
  [[ $(blkid -s TYPE -o value "$ESP_PART" 2>/dev/null || true) == vfat ]] || err+="ESP must already contain a FAT filesystem.\n"
  [[ $ESP_MOUNT == /boot ]] || err+="This installer requires the Asahi ESP at /boot.\n"
  [[ $ASAHI_SETUP != gentoosupport || $ESP_MOUNT == /boot ]] || err+="gentoosupport requires ESP_MOUNT=/boot.\n"
  [[ $HOSTNAME_ =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] || err+="Invalid hostname.\n"
  [[ $TIMEZONE != /* && $TIMEZONE != *..* && -f /usr/share/zoneinfo/$TIMEZONE ]] || err+="Unknown timezone.\n"
  [[ $LOCALE =~ ^[a-zA-Z0-9_.@-]+$ ]] || err+="Invalid locale.\n"
  [[ $KEYMAP =~ ^[a-zA-Z0-9_./-]+$ ]] || err+="Invalid keymap.\n"
  case $ROOT_FS in ext4|btrfs|xfs) ;; *) err+="Invalid root filesystem.\n" ;; esac
  case $USE_LUKS in yes|no) ;; *) err+="Invalid LUKS setting.\n" ;; esac
  case $ASAHI_SETUP in native|gentoosupport) ;; *) err+="Invalid Asahi setup method.\n" ;; esac
  case $NETWORK in iwd|networkmanager|none) ;; *) err+="Invalid network selection.\n" ;; esac
  case $STAGE_VARIANT in openrc|systemd|desktop-openrc|desktop-systemd|llvm-openrc|llvm-systemd) ;; *) err+="Invalid stage variant.\n" ;; esac
  [[ -z $USER_NAME || ( $USER_NAME =~ ^[a-z_][a-z0-9_-]*$ && -n $USER_PW_HASH ) ]] || err+="Invalid username or missing user password.\n"
  if [[ $PROFILE != ask-later ]]; then
    if [[ $STAGE_VARIANT == *systemd ]]; then
      [[ $PROFILE == */systemd ]] || err+="systemd stage needs a systemd profile.\n"
    else
      [[ $PROFILE != */systemd ]] || err+="OpenRC stage needs an OpenRC profile.\n"
    fi
  fi
  [[ $PROFILE == ask-later || $PROFILE == default/linux/arm64/* ]] || err+="Profile should start with default/linux/arm64/.\n"
  if [[ -n $err ]]; then ui_msg "Configuration incomplete" "$(printf '%b' "$err")"; return 1; fi
}

configure() {
  while true; do
    local mark; [[ -n $ROOT_PW_HASH ]] && mark="set" || mark="NOT SET"
    ui_menu "Asahi Gentoo installer v$VERSION" "Configure, then choose 'Install'." \
      part    "Partitions: esp=${ESP_PART:-?} root=${ROOT_PART:-?} swap=${SWAP_PART:-none}" \
      mkpart  "Create partition in free space (cfdisk)" \
      fs      "Filesystem: $ROOT_FS, LUKS=$USE_LUKS" \
      stage   "Stage3: $STAGE_VARIANT" \
      profile "Profile: $PROFILE" \
      system  "System: $HOSTNAME_ / $TIMEZONE / $LOCALE / $KEYMAP" \
      users   "Users: root pw $mark, user=${USER_NAME:-none}" \
      options "Options: ${OPTIONS:-none}" \
      pkgs    "Network=$NETWORK, extra packages/USE" \
      asahi   "Asahi setup: $ASAHI_SETUP, ESP at $ESP_MOUNT" \
      save    "Save config to $CONF_FILE" \
      install "Save and INSTALL" \
      quit    "Quit" || return 1
    case $RET in
      part)    cfg_partitions ;;
      mkpart)  create_partition ;;
      fs)      cfg_filesystem ;;
      stage)   cfg_stage ;;
      profile) cfg_profile ;;
      system)  cfg_system ;;
      users)   cfg_users ;;
      options) cfg_options ;;
      pkgs)    cfg_packages ;;
      asahi)   cfg_asahi ;;
      save)    save_config "$CONF_FILE"; ui_msg "Saved" "Config written to $CONF_FILE" ;;
      install) validate_config && { save_config "$CONF_FILE"; return 0; } ;;
      quit)    return 1 ;;
    esac
  done
}

# ------------------------------------------------------------ stage 1 -------
MOUNTED=0; SWAP_ACTIVE=""; CRYPT_OPEN=0

cleanup() {
  cd / || return 1
  if [[ -n $SWAP_ACTIVE ]]; then swapoff "$SWAP_ACTIVE" || return 1; SWAP_ACTIVE=""; fi
  if ((MOUNTED)); then umount -R "$TARGET" || return 1; MOUNTED=0; fi
  if ((CRYPT_OPEN)); then cryptsetup close cryptroot || return 1; CRYPT_OPEN=0; fi
  return 0
}

preflight() {
  [[ $EUID -eq 0 ]] || die "Run as root."
  [[ $(uname -m) == aarch64 ]] || die "This installer only runs on aarch64 (Apple Silicon)."
  local t; for t in lsblk blkid wget tar chroot wipefs findmnt mountpoint mount umount swapon swapoff install readlink awk grep; do
    command -v "$t" >/dev/null 2>&1 || die "Missing tool: $t"
  done
  if opt VERIFY; then command -v gpg >/dev/null || die "gpg missing."; fi
  [[ -r /proc/device-tree/compatible ]] && grep -aq 'apple,' /proc/device-tree/compatible || die "Apple Silicon device tree not detected."
  [[ -r /dev/tty && -w /dev/tty ]] || die "An interactive terminal is required, including with -y."
  [[ $USE_LUKS == yes ]] && { command -v cryptsetup >/dev/null || die "cryptsetup missing."; }
  case $ROOT_FS in
    ext4) command -v mkfs.ext4 >/dev/null || die "mkfs.ext4 missing" ;;
    btrfs) command -v mkfs.btrfs >/dev/null || die "mkfs.btrfs missing" ;;
    xfs) command -v mkfs.xfs >/dev/null || die "mkfs.xfs missing" ;;
  esac
  wget -q --spider "$GENTOO_MIRROR" || die "No network / mirror unreachable ($GENTOO_MIRROR). Use net-setup or iwctl first."
  if findmnt -rn "$TARGET" >/dev/null 2>&1; then die "$TARGET is already mounted."; fi
  return 0
}

check_asahi_esp() {
  local probe status=0
  probe=$(mktemp -d)
  if ! mount -o ro "$ESP_PART" "$probe"; then rmdir "$probe"; die "Cannot inspect the Asahi ESP."; fi
  [[ -f $probe/m1n1/boot.bin && -d $probe/vendorfw ]] || status=1
  if ! umount "$probe"; then die "Cannot unmount ESP inspection mount: $probe"; fi
  rmdir "$probe"
  ((status == 0)) || die "Selected ESP lacks m1n1/boot.bin or vendorfw; root has not been formatted."
}

confirm_destruction() {
  local msg="About to ERASE and FORMAT:\n\n  root: $ROOT_PART ($ROOT_FS, LUKS=$USE_LUKS)"
  [[ -n $SWAP_PART ]] && msg+="\n  swap: $SWAP_PART"
  msg+="\n\nThe ESP $ESP_PART is mounted at $ESP_MOUNT and NOT formatted.\nNo partition table changes are made."
  if ((ASSUME_YES)); then info "$(printf '%b' "$msg")"; return 0; fi
  ui_yesno "Confirm" "$msg\n\nContinue?" || die "Cancelled."
  local a; read -r -p "Type the root device name to confirm ($ROOT_PART): " a </dev/tty
  [[ $a == "$ROOT_PART" ]] || die "Confirmation mismatch."
}

format_and_mount() {
  local dev=$ROOT_PART
  try wipefs -a "$ROOT_PART"
  if [[ $USE_LUKS == yes ]]; then
    info "Setting up LUKS2 on $ROOT_PART"
    try cryptsetup luksFormat --type luks2 "$ROOT_PART"
    try cryptsetup open "$ROOT_PART" cryptroot
    CRYPT_OPEN=1; dev=/dev/mapper/cryptroot
  fi
  info "Creating $ROOT_FS on $dev"
  case $ROOT_FS in
    ext4)  try mkfs.ext4 -F -L gentoo "$dev" ;;
    btrfs) try mkfs.btrfs -f -L gentoo --sectorsize 16384 "$dev" ;;  # match 16K pages
    xfs)   try mkfs.xfs -f -L gentoo "$dev" ;;
  esac
  if [[ -n $SWAP_PART ]]; then
    try wipefs -a "$SWAP_PART"; try mkswap -L swap "$SWAP_PART"; swapon "$SWAP_PART"; SWAP_ACTIVE=$SWAP_PART
  fi
  mkdir -p "$TARGET"
  local mo="noatime"; [[ $ROOT_FS == btrfs ]] && mo+=",compress=zstd"
  try mount -o "$mo" "$dev" "$TARGET"; MOUNTED=1
  mkdir -p "$TARGET$ESP_MOUNT"
  try mount "$ESP_PART" "$TARGET$ESP_MOUNT"
  [[ -d $TARGET$ESP_MOUNT/vendorfw ]] || die "Asahi vendor firmware is missing from the selected ESP."
  ROOT_FS_DEV=$dev
  if [[ ! -e $TARGET$ESP_MOUNT/m1n1/boot.bin ]]; then
    die "m1n1/boot.bin is missing; select the Asahi stub ESP."
  fi
}

fetch_stage3() {
  local base="$GENTOO_MIRROR/releases/arm64/autobuilds" listing path
  info "Resolving latest stage3-arm64-$STAGE_VARIANT"
  listing="$base/latest-stage3-arm64-$STAGE_VARIANT.txt"
  path=$(wget -qO- "$listing" | awk '/\.tar\.(xz|zst)[[:space:]]/ {print $1; exit}')
  [[ -n $path ]] || die "Could not parse $listing"
  local file=${path##*/}
  cd "$TARGET"
  try wget -c "$base/$path"
  if opt VERIFY; then
    info "Verifying signature"
    try wget -c "$base/$path.asc"
    local gh; gh=$(mktemp -d); chmod 700 "$gh"
    if [[ -r /usr/share/openpgp-keys/gentoo-release.asc ]]; then
      gpg --homedir "$gh" --quiet --import /usr/share/openpgp-keys/gentoo-release.asc
    else
      gpg --homedir "$gh" --quiet --auto-key-locate clear,nodefault,wkd --locate-keys releng@gentoo.org
    fi
    gpg --homedir "$gh" --verify "$file.asc" "$file" || die "Stage3 signature verification FAILED."
    rm -rf "$gh" "$file.asc"
  else warn "Skipping signature verification."; fi
  info "Extracting $file"
  try tar xpf "$file" --xattrs-include='*.*' --numeric-owner -C "$TARGET"
  rm -f "$file"
}

mount_chroot_fs() {
  local t=$1
  mountpoint -q "$t/proc" || mount --types proc /proc "$t/proc"
  mountpoint -q "$t/sys"  || { mount --rbind /sys "$t/sys"; mount --make-rslave "$t/sys"; }
  mountpoint -q "$t/dev"  || { mount --rbind /dev "$t/dev"; mount --make-rslave "$t/dev"; }
  mountpoint -q "$t/run"  || { mount --bind /run "$t/run"; mount --make-slave "$t/run"; }
  cp --dereference /etc/resolv.conf "$t/etc/resolv.conf"
}

enter_stage2() {
  mount_chroot_fs "$TARGET"
  install -m 755 "$SELF" "$TARGET/root/asahi-gentoo-install"
  save_config "$TARGET$CHROOT_CONF"
  {
    printf 'RT_ROOT_DEV=%q\n' "$ROOT_FS_DEV"
    printf 'RT_LUKS_UUID=%q\n' "$([[ $USE_LUKS == yes ]] && blkid -s UUID -o value "$ROOT_PART" || true)"
  } >>"$TARGET$CHROOT_CONF"
  chroot "$TARGET" /usr/bin/env -i HOME=/root TERM="${TERM:-linux}" \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    /bin/bash /root/asahi-gentoo-install --stage2 </dev/tty
  rm -f "$TARGET$CHROOT_CONF" "$TARGET/root/asahi-gentoo-install"
}

install_main() {
  trap 'rc=$?; cleanup || { warn "Cleanup failed; inspect mounts before rebooting."; rc=1; }; exit "$rc"' EXIT
  preflight
  validate_config || die "Configuration failed safety checks."
  check_asahi_esp
  confirm_destruction
  format_and_mount
  fetch_stage3
  enter_stage2
  info "Installation finished. Unmounting..."
  cleanup; trap - EXIT
  info "Done. Reboot, hold the power button to reach the boot picker, and select your Gentoo entry."
}

chroot_only() {
  local t=$1
  [[ -d $t ]] || die "$t does not exist"
  mount_chroot_fs "$t"
  chroot "$t" /bin/bash -l
}

# ------------------------------------------------------------ stage 2 -------
# Runs INSIDE the chroot.
emerge_pkgs() { try emerge --autounmask-continue --noreplace -v "$@"; }
svc_enable() { # name
  if [[ $INIT == systemd ]]; then try systemctl enable "$1.service"
  else try rc-update add "$1" default; fi
}

s2_portage() {
  info "Configuring portage"
  local lic='-* @FREE @BINARY-REDISTRIBUTABLE'; opt LICENSES && lic='*'
  local jobs; jobs=$(nproc)
  {
    echo
    echo "# --- asahi-gentoo-install ---"
    echo "ACCEPT_LICENSE=\"$lic\""
    echo "MAKEOPTS=\"-j$jobs\""
    echo "EMERGE_DEFAULT_OPTS=\"--jobs=2 --load-average=$jobs\""
    echo "VIDEO_CARDS=\"asahi\""
    echo "GRUB_PLATFORMS=\"efi-64\""
    echo "GENTOO_MIRRORS=\"$GENTOO_MIRROR\""
    [[ -n $EXTRA_USE ]] && echo "USE=\"\${USE} $EXTRA_USE\""
    opt TESTING && echo "ACCEPT_KEYWORDS=\"~arm64\""
    opt BINPKG && echo "FEATURES=\"\${FEATURES} getbinpkg binpkg-request-signature\""
  } >>/etc/portage/make.conf
  opt NATIVE && sed -i 's/^COMMON_FLAGS="\(.*\)"/COMMON_FLAGS="\1 -mcpu=native"/' /etc/portage/make.conf
  if opt BINPKG; then
    mkdir -p /etc/portage/binrepos.conf
    cat >/etc/portage/binrepos.conf/gentoobinhost.conf <<EOF
[gentoobinhost]
priority = 1
sync-uri = $GENTOO_MIRROR/releases/arm64/binpackages/23.0/arm64/
EOF
    command -v getuto >/dev/null && getuto || true
  fi
  mkdir -p /etc/portage/repos.conf /etc/portage/package.use /etc/portage/package.accept_keywords
  cp /usr/share/portage/config/repos.conf /etc/portage/repos.conf/gentoo.conf
  try emerge-webrsync
  if opt GITSYNC; then
    emerge_pkgs dev-vcs/git
    sed -i -e 's/^sync-type.*/sync-type = git/' \
           -e 's#^sync-uri.*#sync-uri = https://anongit.gentoo.org/git/repo/sync/gentoo.git#' \
           /etc/portage/repos.conf/gentoo.conf
    rm -rf /var/db/repos/gentoo
    try emerge --sync
  fi
}

s2_profile() {
  if [[ $PROFILE == ask-later ]]; then
    local items=() n name
    while IFS=$'\t' read -r n name; do items+=("$n" "$name"); done < <(
      eselect profile list | sed -n 's/^ *\[\([0-9]*\)\] *\([^ ]*\).*/\1\t\2/p' | awk -v init="$INIT" '$2 ~ /^default\/linux\/arm64\// && ((init == "systemd" && $2 ~ /\/systemd$/) || (init == "openrc" && $2 !~ /\/systemd$/))' || true)
    ui_menu "Profile" "Select a profile (init: $INIT)" "${items[@]}" || die "No profile selected."
    try eselect profile set "$RET"
  else
    try eselect profile set "$PROFILE"
  fi
  info "Profile: $(eselect profile show | tail -n1 | xargs)"
}

s2_system() {
  info "Timezone, locale, keymap, hostname"
  echo "$TIMEZONE" >/etc/timezone
  ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
  grep -q "^$LOCALE " /etc/locale.gen 2>/dev/null || echo "$LOCALE UTF-8" >>/etc/locale.gen
  grep -q '^en_US.UTF-8 ' /etc/locale.gen || echo "en_US.UTF-8 UTF-8" >>/etc/locale.gen
  try locale-gen
  mkdir -p /etc/env.d
  printf 'LANG="%s"\nLC_COLLATE="C.UTF-8"\n' "$LOCALE" >/etc/env.d/02locale
  echo "LANG=$LOCALE" >/etc/locale.conf
  echo "$HOSTNAME_" >/etc/hostname
  if [[ $INIT == systemd ]]; then echo "KEYMAP=$KEYMAP" >/etc/vconsole.conf
  else
    echo "hostname=\"$HOSTNAME_\"" >/etc/conf.d/hostname
    sed -i "s/^keymap=.*/keymap=\"$KEYMAP\"/" /etc/conf.d/keymaps 2>/dev/null || true
  fi
  env-update >/dev/null || true
}

s2_fstab() {
  info "Writing /etc/fstab"
  local ru eu su ro="noatime"
  ru=$(blkid -s UUID -o value "$RT_ROOT_DEV"); eu=$(blkid -s UUID -o value "$ESP_PART")
  [[ $ROOT_FS == btrfs ]] && ro+=",compress=zstd"
  {
    echo "UUID=$ru  /  $ROOT_FS  $ro  0 1"
    echo "UUID=$eu  $ESP_MOUNT  vfat  umask=0077  0 2"
    if [[ -n $SWAP_PART ]]; then echo "UUID=$(blkid -s UUID -o value "$SWAP_PART")  none  swap  sw  0 0"; fi
  } >/etc/fstab
  if [[ $USE_LUKS == yes ]]; then
    echo "cryptroot  UUID=$RT_LUKS_UUID  none  luks" >/etc/crypttab
    emerge_pkgs sys-fs/cryptsetup
    mkdir -p /etc/dracut.conf.d
    echo 'add_dracutmodules+=" crypt dm "' >/etc/dracut.conf.d/10-crypt.conf
    mkdir -p /etc/default
    grep -q rd.luks.uuid /etc/default/grub 2>/dev/null || \
      echo "GRUB_CMDLINE_LINUX=\"\${GRUB_CMDLINE_LINUX} rd.luks.uuid=$RT_LUKS_UUID\"" >>/etc/default/grub
  fi
}

s2_asahi_native() {
  warn "Native Asahi setup is experimental. Prefer ASAHI_SETUP=gentoosupport if it fails."
  emerge_pkgs dev-vcs/git
  cat >/etc/portage/repos.conf/asahi.conf <<EOF
[asahi]
location = /var/db/repos/asahi
sync-type = git
sync-uri = $ASAHI_OVERLAY_URI
auto-sync = yes
priority = 50
EOF
  try emaint -r asahi sync
  echo '*/*::asahi ~arm64' >/etc/portage/package.accept_keywords/asahi
  echo 'sys-kernel/installkernel dracut grub' >/etc/portage/package.use/installkernel
  emerge_pkgs sys-boot/grub sys-kernel/installkernel sys-apps/asahi-meta virtual/dist-kernel:asahi sys-kernel/linux-firmware
  try asahi-fwupdate
  try grub-install --target=arm64-efi --efi-directory="$ESP_MOUNT" --boot-directory=/boot --removable
}

s2_asahi_support() {
  info "Installing Asahi support ($ASAHI_SETUP)"
  emerge_pkgs dev-vcs/git
  if [[ $ASAHI_SETUP == gentoosupport ]]; then
    rm -rf /root/asahi-gentoosupport
    try git clone "$ASAHI_SUPPORT_URI" /root/asahi-gentoosupport
    info "Launching asahi-gentoosupport install.sh - follow its prompts."
    ( cd /root/asahi-gentoosupport && try ./install.sh )
  else
    s2_asahi_native
  fi
  try grub-mkconfig -o /boot/grub/grub.cfg
  if command -v update-m1n1 >/dev/null; then
    try update-m1n1 "$ESP_MOUNT/m1n1/boot.bin"
  else die "update-m1n1 is missing; boot setup is incomplete."; fi
}

s2_network() {
  info "Network: $NETWORK"
  case $NETWORK in
    iwd)
      emerge_pkgs net-wireless/iwd net-dns/openresolv
      if [[ $INIT == openrc ]]; then svc_enable dbus; fi
      mkdir -p /etc/iwd
      printf '[General]\nEnableNetworkConfiguration=true\n[Network]\nNameResolvingService=resolvconf\n' >/etc/iwd/main.conf
      svc_enable iwd ;;
    networkmanager)
      echo 'net-misc/networkmanager iwd' >>/etc/portage/package.use/networkmanager
      emerge_pkgs net-misc/networkmanager net-wireless/iwd
      mkdir -p /etc/NetworkManager/conf.d
      printf '[device]\nwifi.backend=iwd\n' >/etc/NetworkManager/conf.d/wifi_backend.conf
      if [[ $INIT == openrc ]]; then svc_enable dbus; fi
      svc_enable iwd; svc_enable NetworkManager ;;
    none) ;;
  esac
}

s2_users() {
  info "Users"
  echo "root:$ROOT_PW_HASH" | chpasswd -e
  if [[ -n $USER_NAME ]]; then
    local g groups=""
    for g in ${USER_GROUPS//,/ }; do getent group "$g" >/dev/null && groups+="$g,"; done
    local user_args=(-m -s /bin/bash)
    [[ -z $groups ]] || user_args+=(-G "${groups%,}")
    try useradd "${user_args[@]}" "$USER_NAME"
    echo "$USER_NAME:$USER_PW_HASH" | chpasswd -e
  fi
  if opt SUDO; then
    emerge_pkgs app-admin/sudo
    mkdir -p /etc/sudoers.d
    echo '%wheel ALL=(ALL:ALL) ALL' >/etc/sudoers.d/10-wheel
    chmod 440 /etc/sudoers.d/10-wheel
  fi
}

s2_extras() {
  if opt SSHD;   then emerge_pkgs net-misc/openssh; svc_enable sshd; fi
  if opt CHRONY; then emerge_pkgs net-misc/chrony; svc_enable chronyd; fi
  if [[ $INIT == systemd ]]; then systemd-machine-id-setup 2>/dev/null || true; fi
  # shellcheck disable=SC2086
  [[ -n $EXTRA_PACKAGES ]] && emerge_pkgs $EXTRA_PACKAGES
  if opt WORLD; then try emerge --update --deep --newuse --autounmask-continue @world; fi
  return 0
}

stage2() {
  # shellcheck disable=SC1090
  source "$CHROOT_CONF"
  # shellcheck disable=SC1091
  # Gentoo profile scripts need not be safe under nounset.
  set +u
  source /etc/profile
  set -u
  INIT=${STAGE_VARIANT##*-}
  [[ $INIT == openrc || $INIT == systemd ]] || INIT=openrc
  s2_portage
  s2_profile
  s2_system
  s2_fstab
  s2_asahi_support
  s2_network
  s2_users
  s2_extras
  info "Chroot phase complete."
}

# -------------------------------------------------------------- main --------
usage() { sed -n '2,24p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0; }

main() {
  set_defaults
  local mode=menu conf_given=0
  while (($#)); do
    case $1 in
      -c|--config) [[ $# -ge 2 ]] || die "--config needs a filename"; CONF_FILE=$2; conf_given=1; shift ;;
      -y|--yes)    ASSUME_YES=1 ;;
      --chroot)    [[ $# -ge 2 ]] || die "--chroot needs a directory"; mode=chroot; TARGET=$2; shift ;;
      --stage2)    mode=stage2 ;;
      -h|--help)   usage ;;
      *)           die "Unknown argument: $1 (try --help)" ;;
    esac
    shift
  done

  case $mode in
    chroot) [[ $EUID -eq 0 ]] || die "Run as root."; chroot_only "$TARGET"; return ;;
    stage2) stage2; return ;;
  esac

  [[ $EUID -eq 0 ]] || die "Run as root."
  if [[ -f $CONF_FILE ]]; then load_config "$CONF_FILE"; elif ((conf_given)); then die "Config not found: $CONF_FILE"; fi
  if ((ASSUME_YES)); then
    validate_config || die "Config incomplete."
  else
    configure || { info "Nothing installed."; exit 0; }
  fi
  install_main
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
